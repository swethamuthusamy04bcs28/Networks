#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#define INF 999999
int networkDelayTime(int** times, int timesSize, int* timesColSize, int n, int k) {
    int dist[101];
    bool visited[101];
    for (int i = 1; i <= n; i++) {
        dist[i] = INF;
        visited[i] = false;
    }
    dist[k] = 0;
    for (int count = 0; count < n; count++) {
        int u = -1;
        int min_dist = INF;
        for (int i = 1; i <= n; i++) {
            if (!visited[i] && dist[i] < min_dist) {
                min_dist = dist[i];
                u = i;
            }
        }
        if (u == -1) break;
        visited[u] = true;
        for (int i = 0; i < timesSize; i++) {
            if (times[i][0] == u) {
                int v = times[i][1];
                int w = times[i][2];
                if (dist[u] + w < dist[v]) {
                    dist[v] = dist[u] + w;
                }
            }
        }
    }
    int max_time = 0;
    for (int i = 1; i <= n; i++) {
        if (dist[i] == INF) {
            return -1; 
        }
        if (dist[i] > max_time) {
            max_time = dist[i];
        }
    }
    return max_time;
}
